{
  "name": "volet",
  "description": "Vertical tabs in Chrome's side panel, sorted into switchable workspaces",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "wxt",
    "dev:own": "OWN_PROFILE=1 wxt",
    "proto": "vite --config vite.proto.config.ts",
    "build": "wxt build",
    "zip": "wxt zip",
    "store:images": "node store/capture.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:extension": "NODE_ENV=production wxt build --mode e2e && node scripts/check-extension.mjs",
    "test": "vitest run",
    "test:e2e": "NODE_ENV=production wxt build --mode e2e && playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@dnd-kit/collision": "0.5.3",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/svelte": "^0.5.3",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@lucide/svelte": "^1.68.0",
    "bits-ui": "^2.20.4"
  }
}
